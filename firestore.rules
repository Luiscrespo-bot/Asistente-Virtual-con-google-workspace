rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /drawings/{drawingId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId || (request.method == 'create' && request.auth.uid == request.resource.data.userId);
    }
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId || (request.method == 'create' && request.auth.uid == request.resource.data.userId);
    }
  }
}
